# --- Solder API configuration ---------------------------------------------
# Everything here has a working default. `npm run dev` works with no .env file.

PORT=8787

# sim | devnet | mainnet
#   sim     = local simulated ledger (default). Real ed25519 signing, no network.
#   devnet  = real Solana devnet USDC. Requires SOLANA_RPC_URL + RELAYER_SECRET_KEY.
#   mainnet = real money. Read SECURITY.md first.
CHAIN=sim

DATABASE_PATH=./data/solder.db

# WebAuthn relying party. RP_ID must be the domain (no scheme/port).
RP_ID=localhost
ORIGIN=http://localhost:5173

SESSION_TTL_DAYS=30

# Dev-only shortcut login for e2e tests and browsers without passkeys.
# Ignored entirely when NODE_ENV=production.
DEV_LOGIN=1

DAILY_SEND_LIMIT_USD=500

# --- Only needed when CHAIN != sim ----------------------------------------
SOLANA_RPC_URL=
# base58-encoded 64-byte secret key of the fee-paying relayer account
RELAYER_SECRET_KEY=
# Defaults to the canonical USDC mint for the selected cluster when unset.
USDC_MINT=
