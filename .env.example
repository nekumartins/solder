# --- Solder API configuration ---------------------------------------------
# Everything here has a working default. `npm run dev` works with no .env file.

PORT=8787

# sim | sepolia | base-sepolia | base | ethereum
#   sim   = local simulated ledger (default). Real secp256k1 signing, no network.
#   others = real USDC. Requires RPC_URL + RELAYER_PRIVATE_KEY.
# `base` is the sensible real choice: same USDC, gas the relayer can afford.
CHAIN=sim

DATABASE_PATH=./data/solder.db

# WebAuthn relying party. RP_ID must be the domain (no scheme/port).
# ORIGIN accepts a comma-separated list.
RP_ID=localhost
ORIGIN=http://localhost:5173

SESSION_TTL_DAYS=30

# Dev-only shortcut login for e2e tests and browsers without passkeys.
# Ignored entirely when NODE_ENV=production.
DEV_LOGIN=1

DAILY_SEND_LIMIT_USD=500
# Requests per minute per IP. Raise it only for local test runs, which all
# share 127.0.0.1 and would otherwise throttle themselves.
RATE_LIMIT_MAX=120

# --- Only needed when CHAIN != sim ----------------------------------------
RPC_URL=
# 32-byte hex private key of the relayer that pays gas. Keep it funded with a
# little ETH, and no more than you are willing to lose — see SECURITY.md.
RELAYER_PRIVATE_KEY=
# Defaults to Circle's native USDC for the selected network when unset.
# Do not point this at a bridged USDC.e: most do not implement EIP-3009.
USDC_ADDRESS=
