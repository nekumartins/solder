{
  "name": "solder",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @solder/api",
    "dev:web": "npm run dev -w @solder/web",
    "build": "npm run build -w @solder/shared && npm run build -w @solder/web",
    "test": "npm run test -w @solder/shared && npm run test -w @solder/api",
    "seed": "npm run seed -w @solder/api",
    "typecheck": "tsc -b --pretty false",
    "e2e": "node --no-warnings=ExperimentalWarning scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
